{
    "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)astro-blog' || exit 1",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Link",
            "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
          }
        ]
      },
      {
        "source": "/(.*_bg.*)\\.(jpg|jpeg|png|gif|webp|svg)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' *; img-src 'self' data: *;"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer-when-downgrade"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(self), browsing-topics=()"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/analytics-debuuger-v2-3-2",
        "destination": "/ga4-gtm-best-tool-analytics-debugger/",
        "permanent": true
      },
      {
        "source": "/analytics-debuuger-v2-3-2/",
        "destination": "/ga4-gtm-best-tool-analytics-debugger/",
        "permanent": true
      },
      {
        "source": "/analytics-debuuger-v2-3-2/:path*",
        "destination": "/ga4-gtm-best-tool-analytics-debugger/:path*",
        "permanent": true
      },
      {
        "source": "/n8n-resources",
        "destination": "/n8n-tutorial-resources",
        "permanent": true
      },
      {
        "source": "/n8n-tutorial-resources.html",
        "destination": "/n8n-tutorial-resources/",
        "permanent": true
      },
      {
        "source": "/tools/n8n_template/contact.html",
        "destination": "/n8n-expert/",
        "permanent": true
      }
    ]
}
