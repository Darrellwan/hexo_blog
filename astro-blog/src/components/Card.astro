---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { getCoverImage } from "@/utils/getCoverImage";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, ...dateProps } = data;
const href = getPath(id, filePath);
const coverImage = getCoverImage(Astro.props as CollectionEntry<"blog">);
---

<li class="card-item">
  <a href={href} class="card-link group">
    <div class="card-visual">
      {coverImage ? (
        <img
          src={coverImage}
          alt={title}
          loading="lazy"
          decoding="async"
          class="card-img"
        />
      ) : (
        <div class="card-placeholder" />
      )}

      {/* 預設：底部一行標題 */}
      <div class="card-peek">
        <span class="peek-title">{title}</span>
      </div>

      {/* Hover：滑上來的完整資訊 */}
      <div class="card-reveal">
        <Heading
          class="reveal-title"
          style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        >
          {title}
        </Heading>
        <p class="reveal-desc">{description}</p>
        <Datetime {...dateProps} class="reveal-date" />
      </div>
    </div>
  </a>
</li>

<style>
  .card-item {
    list-style: none;
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
  }

  .card-visual {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-muted);
    aspect-ratio: 4 / 5;
  }

  .card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .group:hover .card-img {
    transform: scale(1.04);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-muted), var(--color-border));
  }

  /* ---- Peek: 預設顯示的一行標題 ---- */
  .card-peek {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.85rem 1rem;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #fff;
    transition: opacity 0.3s ease;
  }

  .peek-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- Reveal: hover 滑上來的完整面板 ---- */
  .card-reveal {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;

    /* 預設隱藏在底部下方 */
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease;
  }

  /* Hover 時滑上來 */
  .group:hover .card-reveal {
    transform: translateY(0);
    opacity: 1;
  }

  /* Hover 時隱藏 peek */
  .group:hover .card-peek {
    opacity: 0;
  }

  .reveal-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 0;
  }

  .reveal-desc {
    font-size: 0.8rem;
    line-height: 1.55;
    margin: 0;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reveal-date {
    font-size: 0.72rem;
    opacity: 0.6;
    margin-top: 0.1rem;
  }

  .reveal-date :global(svg) {
    color: #fff;
    stroke: #fff;
  }

  /* ---- Mobile：直接顯示完整資訊 ---- */
  @media (max-width: 580px) {
    .card-item {
      margin-bottom: 1.25rem;
    }

    .card-visual {
      border-radius: 10px;
    }

    .card-peek {
      display: none;
    }

    .card-reveal {
      transform: translateY(0);
      opacity: 1;
      border-radius: 0 0 10px 10px;
    }
  }

  /* ---- prefers-reduced-motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .card-reveal {
      transition: none;
    }
    .card-peek {
      transition: none;
    }
    .card-img {
      transition: none;
    }
  }
</style>
