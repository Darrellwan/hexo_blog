<script
  is:inline
  async
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9673254310878253"
  crossorigin="anonymous"></script>
<ins
  class="adsbygoogle"
  style="display:block; text-align:center;"
  data-ad-layout="in-article"
  data-ad-format="fluid"
  data-ad-client="ca-pub-9673254310878253"
  data-ad-slot="3286736443"></ins>

<script is:inline data-astro-rerun>
  (() => {
    const unitSelector = "ins.adsbygoogle";

    const initializeAds = () => {
      const units = document.querySelectorAll(unitSelector);
      if (!units.length) return;

      units.forEach(unit => {
        if (unit.dataset.adsenseInitialized === "true") return;

        // Mark before queueing so repeated page-load events enqueue each unit
        // only once.
        unit.dataset.adsenseInitialized = "true";
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      });
    };

    const pageLoadKey = "__darrellAdsensePageLoadInstalled";
    if (window[pageLoadKey] !== true) {
      document.addEventListener("astro:page-load", initializeAds);
      window[pageLoadKey] = true;
    }

    // The AdSense queue accepts pushes before its async loader finishes.
    initializeAds();
  })();
</script>
