---
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { getCoverImage } from "@/utils/getCoverImage";
import Datetime from "./Datetime.astro";

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { title, description, tags, ...dateProps } = post.data;
const href = getPath(post.id, post.filePath);
const coverImage = getCoverImage(post);
---

<a href={href} class="group block">
  <article class="hero-card">
    {coverImage && (
      <div class="hero-card-image">
        <img
          src={coverImage}
          alt={title}
          loading="eager"
          decoding="async"
        />
        <div class="hero-card-overlay" />
      </div>
    )}
    <div class:list={["hero-card-content", { "no-image": !coverImage }]}>
      {tags && tags.length > 0 && (
        <div class="hero-card-tags">
          {tags.slice(0, 3).map(tag => (
            <span class="hero-tag">{tag}</span>
          ))}
        </div>
      )}
      <h2 class="hero-card-title">{title}</h2>
      <p class="hero-card-desc">{description}</p>
      <Datetime {...dateProps} class="hero-card-date" />
    </div>
  </article>
</a>

<style>
  .hero-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    background: var(--color-muted);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .group:hover .hero-card {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  :global([data-theme="dark"]) .group:hover .hero-card {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .hero-card-image {
    position: absolute;
    inset: 0;
  }

  .hero-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .group:hover .hero-card-image img {
    transform: scale(1.03);
  }

  .hero-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.3) 40%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  .hero-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    color: #fff;
  }

  .hero-card-content.no-image {
    position: relative;
    color: var(--color-foreground);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
  }

  .hero-card-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .hero-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    letter-spacing: 0.02em;
  }

  .no-image .hero-tag {
    background: var(--color-accent);
    color: var(--color-background);
  }

  .hero-card-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
  }

  .hero-card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
    opacity: 0.9;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-card-date {
    opacity: 0.7;
    font-size: 0.8rem;
  }

  .hero-card-content.no-image .hero-card-date {
    opacity: 0.6;
  }

  /* Tablet */
  @media (max-width: 768px) {
    .hero-card {
      aspect-ratio: 16 / 10;
    }
    .hero-card-title {
      font-size: 1.35rem;
    }
    .hero-card-content {
      padding: 1.25rem;
    }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .hero-card {
      aspect-ratio: 4 / 3;
      border-radius: 8px;
    }
    .hero-card-title {
      font-size: 1.15rem;
    }
    .hero-card-desc {
      -webkit-line-clamp: 1;
      font-size: 0.85rem;
    }
    .hero-card-content {
      padding: 1rem;
    }
  }
</style>
