---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import AdSense from "@/components/AdSense.astro";
import Sidebar from "@/components/Sidebar.astro";
import { getPath } from "@/utils/getPath";
import { getRelatedPosts } from "@/utils/getRelatedPosts";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  no_ads: noAds,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Resolve local OG images beside the article.  The migration keeps the
// original filename in `ogImage`; it is not a root-level public asset.
if (typeof initOgImage === "string") {
  const imagePath = initOgImage.replace(/^\.\//, "");
  ogImageUrl =
    /^(?:https?:)?\/\//i.test(imagePath) || imagePath.startsWith("/")
      ? imagePath
      : `${getPath(post.filePath)}${imagePath}`;
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.filePath)}index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex !== allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;

const relatedPosts = getRelatedPosts(post, posts);
---

<Layout {...layoutProps}>
  <Header />
  <BackButton />
  <div class="post-page-wrapper">
    <main
      id="main-content"
      class:list={["post-main-content pb-12", { "mt-8": !SITE.showBackButton }]}
      data-pagefind-body
    >
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="inline-block text-2xl font-bold text-accent sm:text-3xl"
      >
        {title}
      </h1>
      <div class="my-2 flex items-center gap-2">
        <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
        <span
          aria-hidden="true"
          class:list={[
            "max-sm:hidden",
            { hidden: !SITE.editPost.enabled || hideEditPost },
          ]}>|</span
        >
        <EditPost {hideEditPost} {post} class="max-sm:hidden" />
      </div>
      <article
        id="article"
        class="app-prose mt-8 w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
      >
        <Content />
      </article>

      <hr class="my-8 border-dashed" />

      <EditPost class="sm:hidden" {hideEditPost} {post} />

      <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
      </ul>

      <BackToTopButton />

      <div class="post-share">
        <span class="post-share-label">分享這篇文章</span>
        <div class="post-share-buttons">
          <a
            class="post-share-btn post-share-facebook"
            href={`https://www.facebook.com/sharer.php?u=${Astro.url.href}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Facebook"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path></svg
            >
          </a>
          <a
            class="post-share-btn post-share-x"
            href={`https://x.com/intent/post?url=${Astro.url.href}&text=${encodeURIComponent(title)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on X"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M4 4l11.733 16h4.267l-11.733-16z M4 20l6.768-6.768m2.46-2.46l6.772-6.772"
                stroke="currentColor"
                stroke-width="2"
                fill="none"></path></svg
            >
          </a>
          <a
            class="post-share-btn post-share-linkedin"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url.href}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LinkedIn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"
              ></path></svg
            >
          </a>
          <a
            class="post-share-btn post-share-threads"
            href={`https://www.threads.net/intent/post?text=${encodeURIComponent(title + " " + Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Threads"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.187.408-2.26 1.33-3.017.88-.724 2.104-1.122 3.446-1.122.93 0 1.745.17 2.42.422-.07-.89-.29-1.593-.66-2.085-.497-.66-1.27-1.004-2.3-1.025l-.072-.002c-.858 0-1.59.246-2.164.678l-1.35-1.56C8.848 5.397 10.124 4.95 11.615 4.92l.09-.001c1.594.024 2.854.578 3.746 1.645.83 .994 1.29 2.386 1.402 4.26.423.217.805.467 1.142.752 1.012.856 1.69 2.047 1.962 3.446.355 1.826.09 3.927-1.534 5.575C16.538 22.504 14.462 23.38 12.186 24z"
              ></path></svg
            >
          </a>
          <a
            class="post-share-btn post-share-line"
            href={`https://social-plugins.line.me/lineit/share?url=${Astro.url.href}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LINE"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
              ></path></svg
            >
          </a>
          <button
            class="post-share-btn post-share-copy"
            onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.classList.add('copied');setTimeout(()=>this.classList.remove('copied'),2000)})"
            aria-label="Copy link"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path
                d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
              ></path><path
                d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
              ></path></svg
            >
            <span class="post-share-copy-tooltip">已複製連結！</span>
          </button>
        </div>
      </div>

      {
        !noAds && (
          <div class="post-ad" data-pagefind-ignore>
            <AdSense />
          </div>
        )
      }

      <!-- Bottom CTA -->
      <div class="bottom-cta">
        <div class="bottom-cta-content">
          <div class="bottom-cta-text">
            <h3 class="bottom-cta-title">不想自己建？讓我幫你</h3>
            <p class="bottom-cta-desc">
              已協助 15+ 個團隊導入 n8n 自動化，從流程規劃到上線維護一手包辦。
            </p>
          </div>
          <a href="/n8n-expert/" class="bottom-cta-btn">
            看看我能幫你做什麼
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      {
        relatedPosts.length > 0 && (
          <section
            class="related-posts"
            data-pagefind-ignore
            aria-labelledby="related-posts-title"
          >
            <h2 id="related-posts-title" class="related-posts-title">
              延伸閱讀
            </h2>
            <ul class="related-posts-list">
              {relatedPosts.map(relatedPost => (
                <li>
                  <a
                    href={getPath(relatedPost.filePath)}
                    class="related-post-link"
                  >
                    <span class="related-post-title">
                      {relatedPost.data.title}
                    </span>
                    <span class="related-post-meta">閱讀這篇相關文章 →</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <hr class="my-6 border-dashed" />

      <!-- Previous/Next Post Buttons -->
      <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          prevPost && (
            <a
              href={getPath(prevPost.filePath)}
              class="flex w-full gap-1 hover:opacity-75"
            >
              <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
              <div>
                <span>Previous Post</span>
                <div class="text-sm text-accent/85">{prevPost.title}</div>
              </div>
            </a>
          )
        }
        {
          nextPost && (
            <a
              href={getPath(nextPost.filePath)}
              class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
            >
              <div>
                <span>Next Post</span>
                <div class="text-sm text-accent/85">{nextPost.title}</div>
              </div>
              <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
            </a>
          )
        }
      </div>
    </main>

    <div class="sidebar-wrapper">
      <Sidebar />
    </div>
  </div>
  <Footer />
</Layout>

<style>
  /* ========================
   * 2 欄 Layout
   * ======================== */
  .post-page-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .post-main-content {
    flex: 1;
    min-width: 0; /* 防止 flex child overflow */
  }

  .sidebar-wrapper {
    flex-shrink: 0;
    width: 300px;
    position: sticky;
    top: 1.5rem;
    align-self: flex-start;
    /* 讓 sidebar 在捲動時維持在視窗內 */
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    /* 隱藏 scrollbar 但保留功能 */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  /* 手機版：sidebar 移到文章下方，全寬 */
  @media (max-width: 1024px) {
    .post-page-wrapper {
      flex-direction: column;
    }

    .post-main-content {
      width: 100%;
    }

    .sidebar-wrapper {
      width: 100%;
      position: static;
      max-height: none;
      overflow-y: visible;
    }
  }

  /* ========================
   * Bottom CTA
   * ======================== */
  .bottom-cta {
    margin: 2rem 0;
    border: 2px solid var(--color-accent);
    border-radius: 12px;
    overflow: hidden;
  }

  .bottom-cta-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
  }

  .bottom-cta-text {
    flex: 1;
  }

  .bottom-cta-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0 0.4rem 0;
  }

  .bottom-cta-desc {
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    line-height: 1.6;
    margin: 0;
  }

  .bottom-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.7rem 1.3rem;
    border-radius: 8px;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    white-space: nowrap;
  }

  .bottom-cta-btn:hover {
    opacity: 0.9;
    transform: translateX(3px);
  }

  /* ========================
   * Article AdSense
   * ======================== */
  .post-ad {
    width: 100%;
    min-width: 0;
    margin: 2rem 0;
  }

  .post-ad :global(ins.adsbygoogle) {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  /* ========================
   * Related Posts
   * ======================== */
  .related-posts {
    width: 100%;
    min-width: 0;
    margin: 2.5rem 0;
  }

  .related-posts-title {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .related-posts-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-post-link {
    display: block;
    min-width: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-foreground);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .related-post-link:hover,
  .related-post-link:focus-visible {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
  }

  .related-post-title {
    display: block;
    overflow-wrap: anywhere;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .related-post-meta {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .bottom-cta-content {
      flex-direction: column;
      text-align: center;
      padding: 1.25rem 1.5rem;
    }

    .bottom-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .sidebar-wrapper {
      scroll-behavior: auto;
    }

    .bottom-cta-btn:hover {
      transform: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );

  /** Inject FAQ Schema.org structured data by reading from DOM */
  function injectFaqSchema() {
    // Remove any previously injected FAQ schemas (e.g. after page transitions)
    document.querySelectorAll("script[data-faq-ld]").forEach(function (el) {
      el.remove();
    });

    const faqItems = document.querySelectorAll("#article .faq-item");
    if (!faqItems.length) return;

    const mainEntity = Array.from(faqItems)
      .map(function (item) {
        const q = item.querySelector(".faq-question-text");
        const a = item.querySelector(".faq-answer-text");
        return {
          "@type": "Question",
          name: q ? q.textContent?.trim() || "" : "",
          acceptedAnswer: {
            "@type": "Answer",
            text: a ? a.textContent?.trim() || "" : "",
          },
        };
      })
      .filter(function (item) {
        return item.name;
      });

    if (!mainEntity.length) return;

    const schema = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: mainEntity,
    };

    const script = document.createElement("script");
    script.type = "application/ld+json";
    script.setAttribute("data-faq-ld", "1");
    script.textContent = JSON.stringify(schema);
    document.head.appendChild(script);
  }
  document.addEventListener("astro:page-load", injectFaqSchema);
  injectFaqSchema();
</script>
