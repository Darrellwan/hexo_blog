---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";
import "@/styles/global.css";
import "../styles/hexo-tags.css";

type Props = {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string | URL;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
};

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

const normalizePagePath = (pathname: string) => {
  let normalized = pathname.split("?")[0].split("#")[0] || "/";

  if (!normalized.startsWith("/")) normalized = `/${normalized}`;
  normalized = normalized.replace(/\/index\.html$/, "/");

  // Astro directory routes use a trailing slash, which must also be the
  // page_path sent to GTM and GA4.
  if (
    normalized !== "/" &&
    !normalized.endsWith("/") &&
    !/\.[^/]+$/.test(normalized)
  ) {
    normalized = `${normalized}/`;
  }

  return normalized;
};

const canonicalHref = new URL(
  canonicalURL instanceof URL
    ? canonicalURL.href
    : canonicalURL || Astro.url.pathname,
  Astro.url
).href;
const canonicalPath = normalizePagePath(new URL(canonicalHref).pathname);
const routePath = normalizePagePath(Astro.url.pathname);

const blogPosts = await getCollection("blog", ({ data }) => !data.draft);
const getCandidatePath = (value: string | undefined) => {
  if (!value) return undefined;

  try {
    return normalizePagePath(new URL(value, Astro.url).pathname);
  } catch {
    return undefined;
  }
};

const currentPost = blogPosts.find(post => {
  const candidatePaths = [
    getCandidatePath(post.data.canonicalURL),
    getCandidatePath(getPath(post.id, post.filePath, false)),
    getCandidatePath(getPath(post.id, post.filePath, true)),
    getCandidatePath(`/${post.id}/`),
    getCandidatePath(post.data.slug ? `/${post.data.slug}/` : undefined),
  ];

  return (
    candidatePaths.includes(canonicalPath) || candidatePaths.includes(routePath)
  );
});

const postData = currentPost?.data;
const articlePublishedAt = pubDatetime ?? postData?.pubDatetime;
const articleModifiedAt = modDatetime ?? postData?.modDatetime;
const articleTitle = postData?.title ?? title;
const articleDescription = postData?.description ?? description;

const pageData: Record<string, unknown> = {
  title: articleTitle,
  page_path: canonicalPath,
  url: canonicalHref,
  post_description: articleDescription,
};

if (articlePublishedAt) pageData.page_date = articlePublishedAt.toISOString();
if (articleModifiedAt) pageData.page_updated = articleModifiedAt.toISOString();

if (postData) {
  pageData.page_id = currentPost?.id;
  pageData.page_categories = postData.categories;
  pageData.page_tags = postData.tags;
  pageData.post_permalink = canonicalHref;
  if (postData.page_type) pageData.type = postData.page_type;
}

const socialImageURL = new URL(ogImage, Astro.url);
const authorSchema = {
  "@type": "Person",
  name: author,
  ...(profile && { url: profile }),
};

const structuredData =
  canonicalPath === "/"
    ? {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        url: canonicalHref,
        description,
        author: authorSchema,
      }
    : canonicalPath === "/about/"
      ? {
          "@context": "https://schema.org",
          "@type": "ProfilePage",
          name: title,
          url: canonicalHref,
          description,
          mainEntity: authorSchema,
        }
      : articlePublishedAt
        ? {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            headline: articleTitle,
            image: socialImageURL.href,
            datePublished: articlePublishedAt.toISOString(),
            ...(articleModifiedAt && {
              dateModified: articleModifiedAt.toISOString(),
            }),
            author: [authorSchema],
          }
        : {
            "@context": "https://schema.org",
            "@type": "WebPage",
            name: title,
            url: canonicalHref,
            description,
            author: authorSchema,
          };

// Keep JSON data safe inside an inline script element. The escaped value is
// decoded by JSON.parse when the page data is read by the GTM navigation hook.
const serializedPageData = JSON.stringify(pageData).replace(/</g, "\\u003c");
---

<!doctype html>
<html
  dir={SITE.dir}
  lang=`${SITE.lang ?? "en"}`
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    <meta name="generator" content={Astro.generator} />

    <!-- Load Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageURL.href} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalHref} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL.href} />

    <!-- GTM page data must be available before the official loader runs. -->
    <script
      id="page-datalayer"
      type="application/json"
      is:inline
      set:html={serializedPageData}
    />
    <script is:inline>
      (function () {
        function readPageData() {
          const element = document.getElementById("page-datalayer");
          if (!element?.textContent) return null;

          try {
            return JSON.parse(element.textContent);
          } catch {
            return null;
          }
        }

        const initialPageData = readPageData();
        window.dataLayer = window.dataLayer || [];

        // The initial page object replaces the old Hexo head data layer push.
        if (initialPageData && !window.__gtmInitialPageDataPushed) {
          window.dataLayer.push(initialPageData);
          window.__gtmInitialPageDataPushed = true;
          window.__gtmLastPageKey =
            initialPageData.url ||
            initialPageData.page_path ||
            window.location.href;
        }

        // Astro can evaluate inline scripts again after a transition. Keep one
        // listener for the document and read the newly swapped page data.
        if (window.__gtmNavigationListenerInstalled) return;
        window.__gtmNavigationListenerInstalled = true;

        document.addEventListener("astro:page-load", function () {
          const nextPageData = readPageData();
          if (!nextPageData) return;

          const nextPageKey =
            nextPageData.url || nextPageData.page_path || window.location.href;
          if (nextPageKey === window.__gtmLastPageKey) return;

          window.__gtmLastPageKey = nextPageKey;
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            ...nextPageData,
            event: "virtual_pageview",
          });
        });
      })();
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      /* eslint-disable no-var -- Preserve Google's official GTM snippet. */
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-WRZDBFS");
      /* eslint-enable no-var */
    </script>

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Minimal inline script to prevent FOUC - sets theme immediately -->
    <script is:inline>
      (function () {
        const initialColorScheme = ""; // "light" | "dark"
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (initialColorScheme) return initialColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();

        // Set theme immediately to prevent flash
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        // Export minimal API for external script
        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WRZDBFS"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <slot />

    <!-- Load full theme logic -->
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
