{
  "name": "darrelltw-blog",
  "type": "module",
  "version": "5.5.1",
  "scripts": {
    "dev": "npx tsx scripts/copy-assets-to-public.ts && astro dev",
    "build": "npx tsx scripts/copy-assets-to-public.ts && astro check && astro build && rm -rf dist/pagefind public/pagefind && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test:anchors": "npx tsx tests/heading-anchors.ts",
    "test:anchors:live": "npx tsx tests/verify-legacy-anchors.ts",
    "test:anchors:internal": "npx tsx tests/verify-internal-anchors.ts",
    "test:url-contract": "npx tsx tests/verify-url-contract.ts",
    "test:headers": "npx tsx tests/verify-headers.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.7",
    "dayjs": "^1.11.19",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pagefind/default-ui": "^1.4.0",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cheerio": "^0.22.35",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.51.0",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
