# Migrated from the root vercel.json headers rules.
#
# This site runs on Workers Static Assets, not Cloudflare Pages. Workers applies
# and merges every matching URL pattern; matching one rule does not stop the
# others. Redirects are applied before headers.
#
# The vercel.json `_bg` cache rule is deliberately NOT ported. See
# docs/cloudflare-headers-matrix.md for the measurements behind that decision.

/*
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval' *; img-src 'self' data: *;
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: geolocation=(self), browsing-topics=()

# Root-only Link header rule. `/*` also matches `/`, so the home page receives
# this header on top of the five above. The header names do not overlap, so
# there is no value-joining to reason about.
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml"
